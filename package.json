{
  "name": "financial-guidance-engine",
  "version": "1.0.0",
  "description": "Goal-based financial planning application for Indian financial-advisor clients",
  "main": "backend/src/server.js",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node backend/src/server.js",
    "dev": "node --watch backend/src/server.js",
    "db:setup": "node database/setup.js",
    "db:migrate": "node database/migrate.js",
    "db:seed": "node database/seed.js",
    "db:reset:development": "node database/reset.js",
    "test": "node --test backend/tests/services/*.test.js backend/tests/api/*.test.js",
    "test:services": "node --test backend/tests/services/*.test.js",
    "test:api": "node --test backend/tests/api/*.test.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "decimal.js": "^10.5.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5",
    "puppeteer": "^24.4.0",
    "tesseract.js": "^7.0.0",
    "zod": "^3.24.2"
  },
  "keywords": [
    "financial-planning",
    "tax-calculator",
    "sip-calculator",
    "goal-planning",
    "amfi-overlap"
  ],
  "author": "",
  "license": "ISC"
}
