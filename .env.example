# Application Configuration
NODE_ENV=development
PORT=3000

# SQLite Database (Local Development & Prototype)
SQLITE_DATABASE_PATH=./data/financial_guidance.sqlite

# Security & Session
# Generate a cryptographically random secret in production
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars_long
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_a_secure_cookie_signing_secret

# CORS
CORS_ORIGIN=http://localhost:3000

# Engine Version
ENGINE_VERSION=1.0.0
